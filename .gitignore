# Environment variables (credentials)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Virtualenv local (deps del backend — no se versiona, cada PC arma la suya)
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Media uploads
media/

# Logs
*.log

# Scripts de debug / testing local
scripts/

# Tests E2E ad-hoc (sales_test.mjs, wa_sales_test.mjs, etc.) y sus outputs.
# Útiles para probar contra prod, pero no se versionan — cada PC tiene los suyos.
*_test.mjs
*_test_quick.mjs
*_diag.mjs
*_test_results.txt
_tmp_*.json

# Claude Code lock files (scheduler local)
.claude/scheduled_tasks.lock

# Deploy scripts with credentials
deploy_*.py

# Claude Code: ignorar worktrees y settings locales, pero conservar
# memory/ que sí vale la pena versionar para portarlo entre PCs.
.claude/worktrees/
.claude/settings.local.json
.claude/file-history/
.claude/sessions/

# Playwright — outputs de tests (traces, screenshots, videos, html report)
frontend/test-results/
frontend/playwright-report/
frontend/playwright/.cache/

# Next.js
frontend/.next/
frontend/out/
frontend/tsconfig.tsbuildinfo

# Node modules
node_modules/
